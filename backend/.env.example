# =============================================================
#  MOVA backend - variables de entorno
#  Copiá este archivo como .env y completá los valores.
# =============================================================
NODE_ENV=development
PORT=4000

# ---------- Base de datos MySQL EN LA NUBE (no local) ----------
# Ejemplo Aiven (plan gratuito): host = mysql-mova-xxxx.aivencloud.com, puerto 2xxxx
DB_HOST=mysql-mova-tuproyecto.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=cambiar
DB_NAME=mova_db
# Los proveedores en la nube exigen conexión cifrada
DB_SSL=true
# Opcional: certificado CA del proveedor (Aiven: "CA certificate"). Pegalo en una línea
# reemplazando los saltos de línea por \n, o dejá vacío para usar las CA del sistema.
DB_SSL_CA=
# Zona horaria usada por NOW()/CURDATE() (Argentina = -03:00)
DB_TIMEZONE=-03:00
# Alternativa: una sola URL (Railway la entrega así). Si está definida, tiene prioridad.
# DATABASE_URL=mysql://usuario:clave@host:puerto/mova_db

# ---------- JWT ----------
# Generá valores largos y aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_por_un_secreto_largo
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7

# ---------- CORS (orígenes permitidos separados por coma; * = todos) ----------
CORS_ORIGIN=*

# ---------- Email (verificación de cuenta y doble factor) ----------
# Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MOVA <no-reply@mova.app>"
# Solo para desarrollo: si no hay SMTP configurado, el código se devuelve en la
# respuesta (campo devCode) para poder probar. Nunca activar en producción.
DEV_SHOW_CODES=true

# ---------- Inicio de sesión con redes sociales ----------
# Google: IDs de cliente OAuth (web, android, ios) separados por coma
GOOGLE_CLIENT_IDS=
# Facebook: se valida el access token contra Graph API
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# GitHub: OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple (solo iOS): bundle identifier de la app
APPLE_BUNDLE_ID=com.eest5.mova

# ---------- Reglas del gimnasio ----------
AVISO_DIAS_ANTES=2          # avisos preventivos N días antes del vencimiento / revisión
GRACIA_CUOTA_DIAS=5         # días de gracia luego del vencimiento antes de bloquear
GRACIA_PRESTAMO_DIAS=3      # días de atraso en devolución de material antes de bloquear
INACTIVIDAD_DIAS=60         # días sin asistencia para bloquear por inactividad
