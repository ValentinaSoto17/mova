# URL del backend. En la PC: http://localhost:4000 · Publicado: tu URL de Render.
# En el celular NO uses localhost:
# usá la URL de Render o la IP de tu PC en la red (ej. http://192.168.0.10:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Muestra los botones de "Cuentas de prueba" en el login (true/false)
EXPO_PUBLIC_DEMO_MODE=true

# ----- Inicio de sesión con redes sociales (ver README) -----
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
