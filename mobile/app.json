{
  "expo": {
    "name": "MOVA",
    "slug": "mova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mova",
    "userInterfaceStyle": "automatic",
    "description": "MOVA: Entrena. Progresa. Evoluciona. Gestión integral de gimnasio.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5FB",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0D0C17"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eest5.mova",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.eest5.mova",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1A4A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "MOVA",
      "themeColor": "#5B4BFF",
      "backgroundColor": "#F6F5FB",
      "lang": "es"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F6F5FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D0C17"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4BFF"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}